/// @file build_info.hpp
/// @brief What was built: generated by kernel/CMakeLists.txt when CMake configures the build.
#pragma once

#include <string_view>

namespace @BUILD_INFO_NAMESPACE@::build {
inline constexpr std::string_view os_name = "@PROJECT_NAME@";
inline constexpr std::string_view os_version = "@PROJECT_VERSION@";
/// Abbreviated hash of the commit checked out at configure time, "unknown" outside git.
inline constexpr std::string_view git_commit = "@BUILD_INFO_GIT_COMMIT@";
}  // namespace @BUILD_INFO_NAMESPACE@::build
