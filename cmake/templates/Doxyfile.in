# Doxygen configuration for @PROJECT_NAME@, filled in by DocsBuilder.cmake.
# Anything not set here keeps Doxygen's default.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@DOXYGEN_PROJECT_BRIEF@"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO

# ------------------------------------------------------------------------------
# Input
# ------------------------------------------------------------------------------
INPUT                  = @DOXYGEN_INPUT@
EXCLUDE                = @DOXYGEN_EXCLUDE@
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cpp
INPUT_ENCODING         = UTF-8
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = @DOXYGEN_INCLUDE_PATH@

# ------------------------------------------------------------------------------
# What to document. Everything, documented or not, so that the JSON is a full
# map of the API; implementation details in anonymous namespaces stay out.
# ------------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_RELATIONS   = NO
INLINE_INHERITED_MEMB  = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
NUM_PROC_THREADS       = 0

# ------------------------------------------------------------------------------
# Preprocessor: expand the project's macros, so that static calls and bit
# fields show up as the functions they declare.
# ------------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = @DOXYGEN_INCLUDE_PATH@
PREDEFINED             = __cplusplus=202400L __x86_64__=1 __clang__=1

# ------------------------------------------------------------------------------
# Warnings: real documentation errors go to a log file instead of the build
# output; missing documentation is not an error.
# ------------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = "@DOXYGEN_OUTPUT_DIR@/warnings.log"

# ------------------------------------------------------------------------------
# Output: browsable HTML, and the XML the JSON is made from.
# ------------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = YES
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
XML_NS_MEMB_FILE_SCOPE = NO

HAVE_DOT               = @DOXYGEN_HAVE_DOT@
DOT_PATH               = "@DOXYGEN_DOT_PATH@"
